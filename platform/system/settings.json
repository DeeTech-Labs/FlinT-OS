{
    "id": "system.settings",
    "name": "Settings",
    "publisher": "deetech",
    "version": 1,
    "permissions": [
        "ui.render",
        "system.settings.read",
        "system.locale.read"
    ],
    "components": [
        {
            "id": "main",
            "type": "app",
            "role": "settings",
            "ui": [
                {
                    "kind": "rect",
                    "w": 280,
                    "h": 240,
                    "color": "theme.background"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 42,
                    "center": true,
                    "text": "${locale:settings}",
                    "color": "theme.accent"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 130,
                    "center": true,
                    "font": 0,
                    "text": "UTC offset: ${settings:utc_offset}",
                    "color": "theme.text"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 190,
                    "center": true,
                    "text": "Configure in FlinT Desktop",
                    "color": "theme.accent"
                }
            ]
        }
    ]
}
