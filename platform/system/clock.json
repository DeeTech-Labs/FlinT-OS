{
    "id": "system.clock",
    "name": "Clock",
    "publisher": "deetech",
    "version": 1,
    "permissions": [
        "ui.render",
        "time.read",
        "system.locale.read"
    ],
    "components": [
        {
            "id": "main",
            "type": "watchface",
            "role": "clock",
            "ui": [
                {
                    "kind": "rect",
                    "w": 280,
                    "h": 240,
                    "color": "theme.background"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 42,
                    "center": true,
                    "text": "${locale:clock}",
                    "color": "theme.accent"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 130,
                    "center": true,
                    "font": 1,
                    "text": "${time.read}",
                    "color": "theme.text"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 185,
                    "center": true,
                    "text": "${time.date}",
                    "color": "theme.text"
                }
            ]
        }
    ]
}
