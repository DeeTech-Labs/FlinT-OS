# FlinT OS defaults — ESP32-C3 + 4MB flash (compact + responsive)
# Offline firmware: time sync over native USB Serial/JTAG.
CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# USB Serial/JTAG console (ESP32-C3 DevKit)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Keep 1000 Hz: UI uses pdMS_TO_TICKS(1..2); at 100 Hz those become 10 ms.
CONFIG_FREERTOS_HZ=1000

# Size-first compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Quiet IDF logs (app uses DEBUG_LEVEL / printf)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2
