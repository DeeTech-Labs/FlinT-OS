# FlinT OS defaults — ESP32-S3 + 4MB flash (compact + responsive)
# Offline firmware: time sync over native USB Serial/JTAG.
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Verified ESP32-S3 Super Mini: embedded 2 MiB quad PSRAM (3.3 V).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# Binary Companion owns USB Serial/JTAG; console output must not interleave frames.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# USB launch nests Core, package validation and scene decoding on the main task.
# The measured call chain exceeds 8 KiB; keep headroom for filesystem/BLE calls.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Preserve the 2 ms yield after processing input.
CONFIG_FREERTOS_HZ=1000

# Size-first compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Quiet IDF logs; no textual protocol console.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

# BLE companion: single peripheral connection, no Wi-Fi or HID.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# Authenticated numeric comparison; keys survive restart. Never evict a trusted peer automatically.
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# Read-only factory packages and writable application storage.
CONFIG_LITTLEFS_MAX_PARTITIONS=2
