{
    "id": "example.pc-monitor",
    "name": "PC Monitor",
    "publisher": "deetech",
    "version": 1,
    "permissions": [
        "ui.render",
        {
            "id": "companion.pc.metrics",
            "scope": "cpu,ram"
        }
    ],
    "components": [
        {
            "id": "main",
            "type": "app",
            "ui": [
                {
                    "kind": "rect",
                    "w": 280,
                    "h": 240,
                    "color": "theme.background"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 42,
                    "center": true,
                    "text": "PC Monitor",
                    "color": "theme.accent"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 130,
                    "center": true,
                    "font": 0,
                    "text": "${companion.pc.metrics}",
                    "color": "theme.text"
                }
            ]
        }
    ]
}
