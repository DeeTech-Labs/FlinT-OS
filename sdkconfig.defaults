# FlinT OS defaults — ESP32-C3 + 4MB flash (compact + responsive)
CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# USB Serial/JTAG console (ESP32-C3 DevKit)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000

# Size-first compiler (faces stay snappy; Wi-Fi stack dominates flash)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Quiet IDF logs (app uses DEBUG_LEVEL / printf)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

# No Bluetooth (wall clock is Wi-Fi STA only)
# CONFIG_BT_ENABLED is not set

# Wi-Fi STA only (SoftAP / enterprise not used)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# IPv4-only — weather + NTP do not need IPv6
CONFIG_LWIP_IPV6=n

# Weather uses plain HTTP — no TLS client / CA bundle / websocket framing
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_WS_TRANSPORT=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
