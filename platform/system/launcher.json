{
    "id": "system.launcher",
    "name": "Launcher",
    "publisher": "deetech",
    "version": 1,
    "permissions": [
        "ui.render",
        "packages.list",
        "system.locale.read"
    ],
    "components": [
        {
            "id": "main",
            "type": "app",
            "role": "launcher",
            "ui": [
                {
                    "kind": "rect",
                    "w": 280,
                    "h": 240,
                    "color": "theme.background"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 42,
                    "center": true,
                    "text": "${locale:launcher}",
                    "color": "theme.accent"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 130,
                    "center": true,
                    "font": 0,
                    "text": "${packages.list}",
                    "color": "theme.text"
                }
            ]
        }
    ]
}
