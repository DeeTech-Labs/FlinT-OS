# FlinT OS defaults — ESP32-C3 + 4MB flash (compact + responsive)
# Target: WPA2-PSK STA + NTP + occasional plain HTTP (no SoftAP / WPA3).
CONFIG_IDF_TARGET="esp32c3"

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# USB Serial/JTAG console (ESP32-C3 DevKit)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Keep 1000 Hz: weather/UI use pdMS_TO_TICKS(1..2); at 100 Hz those become 10 ms.
CONFIG_FREERTOS_HZ=1000

# Size-first compiler (faces stay snappy; Wi-Fi stack dominates flash)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Quiet IDF logs (app uses DEBUG_LEVEL / printf)
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL=2

# No Bluetooth (wall clock is Wi-Fi STA only)
# CONFIG_BT_ENABLED is not set

# Wi-Fi STA only — SoftAP / enterprise unused; modest dynamic buffer cut (was 16/16)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# WPA2-PSK only (WPA3 SAE / OWE / GMAC unused — reclaim flash; won't join WPA3-only APs)
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_GMAC_SUPPORT=n

# IPv4-only — weather + NTP do not need IPv6
CONFIG_LWIP_IPV6=n
# No SoftAP → no DHCP server; STA uses DHCP client only
CONFIG_LWIP_DHCPS=n
# Sized for NTP (UDP) + one occasional HTTP client (was 16 TCP / 10 sockets / 5.7 KB windows)
CONFIG_LWIP_MAX_ACTIVE_TCP=4
CONFIG_LWIP_MAX_LISTENING_TCP=2
CONFIG_LWIP_MAX_UDP_PCBS=6
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_MAX_RAW_PCBS=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n

# Weather uses plain HTTP — no HTTPS client / CA bundle / websocket framing.
# Note: esp_http_client → tcp_transport → esp-tls still selects MBEDTLS_TLS_ENABLED,
# so the TLS *protocol* cannot be fully removed; trim server/features/curves instead.
# Wi-Fi CCMP still uses mbedTLS cipher primitives via ESP_WIFI_MBEDTLS_CRYPTO.
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_WS_TRANSPORT=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_SELF_TEST=n
CONFIG_MBEDTLS_SSL_ALPN=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=n
CONFIG_MBEDTLS_SERVER_SSL_SESSION_TICKETS=n
# Smaller TLS record buffers (unused for plain HTTP, but linked via esp-tls)
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
# Keep SECP256R1 (selected by Wi-Fi crypto); drop unused curves
# CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set
# CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED is not set
